---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts"))
  .filter((post) => !post.data.draft)
  .filter((post) => !post.data.tags.includes("projects"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Dominic German">
  <div class="index-content framed">
    <h1 id="hello-there">Dominic German</h1>
    <p>
	Hi, I'm Dominic. This website is meant to show off stuff that I'm working
	on but like everyone with a personal website, it's hopelessly out of date. I mostly use it as a repository of homelab notes I have taken over the years. 
    </p>
  </div>

  <div class="posts">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</BaseLayout>
