---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts"))
  .filter((post) => !post.data.draft)
  .filter((post) => !post.data.tags.includes("projects"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Dominic German">
  <div class="index-content framed">
    <h1 id="hello-there">Hello, I'm Dom.</h1>
    <p>
      This is my website/blog. Its primary purpose is to document my homelab
      journey but I also sometimes post about other topics.
    </p>
  </div>

  <div class="posts">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</BaseLayout>
