---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts"))
  .filter((post) => !post.data.draft)
  .filter((post) => !post.data.tags.includes("projects"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Dominic German">
  <div class="index-content framed">
    <h1 id="hello-there">Dominic German</h1>
    <p>
      Welcome to my website/blog! It's meant to show off stuff that I'm working
      on but it's mostly just a repository of homelab notes I have taken over
      the years.
    </p>
  </div>

  <div class="posts">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</BaseLayout>
